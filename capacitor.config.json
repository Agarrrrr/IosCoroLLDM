{
  "appId": "com.lldm.coro",
  "appName": "Coro LLDM",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "iosScheme": "ionic",
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "never"
  },
  "ios": {
    "packageClassList": [
      "AppPlugin",
      "FilesystemPlugin",
      "NativePDFPlugin",
      "NativeAudioPlugin"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#1a1a2e",
      "showSpinner": false,
      "androidSpinnerStyle": "small"
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#00000000",
      "overlaysWebView": true
    }
  }
}
