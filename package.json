{
  "name": "repertorio-bc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verifyDomain.js && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "build:android": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "run:android": "npm run build && npx cap sync android && npx cap run android",
    "build:ios": "npm run build && npx cap sync ios && node scripts/registerLocalPlugins.js",
    "open:ios": "npx cap open ios",
    "run:ios": "npm run build && npx cap sync ios && node scripts/registerLocalPlugins.js && npx cap run ios"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-legacy": "^6.0.2",
    "@vitest/ui": "^4.1.6",
    "jsdom": "^29.1.1",
    "terser": "^5.46.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.0",
    "@revenuecat/purchases-capacitor": "^13.1.7",
    "@tonejs/midi": "^2.0.28",
    "@tonejs/piano": "^0.2.1",
    "events": "^3.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "puppeteer": "^25.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-pdf": "^10.4.1",
    "soundfont-player": "^0.12.0",
    "stream": "^0.0.3",
    "string-similarity": "^4.0.4",
    "tone": "^14.9.17"
  }
}
